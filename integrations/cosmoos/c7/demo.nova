// profile: freestanding
// C7c: the lock bindings (c7/sync.nova) used as kernel code uses them, behind exports that the host test
// (c7/host_test.c) and the kernel checks (c7.py) call. Each export makes its locks in KernelHeap boxes, works under
// their guards, and reports what it saw through c7_locks_held(), which the C side answers from the spinlock
// implementation it is linked with (CosmoOS's host shim, or the kernel's own lock state).

extern "C" {
    /// How many spinlocks the calling CPU holds now.
    @effects()
    fn c7_locks_held() -> u32;
    /// Counts a Tracked value's drop, by tag.
    @effects()
    fn c7_note_drop(tag: u32);
    /// How many Tracked values have been dropped so far.
    @effects()
    fn c7_drops() -> u32;
}

/// A value whose drop C can see.
struct Tracked {
    tag: u32;

    /// Safety: c7_note_drop only counts.
    drop {
        unsafe { c7_note_drop(this.tag); }
    }
}

struct Stats {
    hits: u64;
    seen: u64;
}

/// A table under a mutex, with a spin-locked counter inside it: a spinlock may be taken under a mutex.
struct Table {
    entries: u64;
    counter: Box<SpinLock<u64>, KernelHeap>;
}

fn statsLock() -> Result<Box<SpinLock<Stats>, KernelHeap>, AllocError> =>
    SpinLock<Stats>.create("nova.c7.stats\0".ptr as *CChar, Stats { hits: 0, seen: 0 });

/// Takes a spinlock `n` times; under the guard, counts a hit and how many locks are held (1 each time). Returns
/// hits * 1000 + locks seen held, then + 1,000,000 if no lock is held afterwards; 0 if the lock cannot be made.
/// Safety: c7_locks_held only reads the lock state.
@export("c7_spin")
fn spin(n: u64) -> u64 {
    match (statsLock()) {
        Err(e) => { return 0; }
        Ok(lock) => {
            for (i in 0..n) {
                var guard = lock.lock();
                let stats = guard.data();
                stats.hits += 1;
                stats.seen += unsafe { c7_locks_held() } as u64;
            }
            var released: u64 = 0;
            if (unsafe { c7_locks_held() } == 0) { released = 1000000; }
            var guard = lock.lock();
            let stats = guard.data();
            return stats.hits * 1000 + stats.seen + released;
        }
    }
}

/// The same with interrupts disabled, nested two deep (released in reverse order): returns the depth seen inside.
/// Safety: as spin.
@export("c7_irq_nested")
fn irqNested() -> u32 {
    let outer = IrqSpinLock<u32>.create("nova.c7.irq.outer\0".ptr as *CChar, 1);
    let inner = IrqSpinLock<u32>.create("nova.c7.irq.inner\0".ptr as *CChar, 2);
    match (outer) {
        Err(e) => { return 0; }
        Ok(a) => {
            match (inner) {
                Err(e) => { return 0; }
                Ok(b) => {
                    var ga = a.lock();
                    var gb = b.lock();
                    let depth = unsafe { c7_locks_held() };
                    let sum = ga.data() + gb.data();
                    return depth * 10 + sum;
                }
            }
        }
    }
}

/// A mutex around a table whose counter is a spinlock: takes the mutex, then the spinlock under it, `n` times.
/// Returns entries * 1000 + the counter, or 0 if a lock cannot be made.
/// Safety: as spin.
@export("c7_mutex")
fn mutexTable(n: u64) -> u64 {
    let counter = SpinLock<u64>.create("nova.c7.counter\0".ptr as *CChar, 0);
    match (counter) {
        Err(e) => { return 0; }
        Ok(c) => {
            match (Mutex<Table>.create("nova.c7.table\0".ptr as *CChar, Table { entries: 0, counter: c })) {
                Err(e) => { return 0; }
                Ok(table) => {
                    for (i in 0..n) {
                        var held = table.lock();
                        let t = held.data();
                        t.entries += 1;
                        var inner = t.counter.lock();
                        let count = inner.data();
                        count += 2;
                    }
                    var held = table.lock();
                    let t = held.data();
                    var inner = t.counter.lock();
                    return t.entries * 1000 + inner.data();
                }
            }
        }
    }
}

/// A kernel object shared by four references, three of them dropped again. Returns the data's tag * 100, the count
/// with four live * 10, the count after (1), and whether the data was dropped meanwhile (+ 1000): 741 if all is well,
/// 0 if the object cannot be made. The last reference is dropped on return, which releases the object.
/// Safety: c7_drops only reads a counter.
@export("c7_kref")
fn kref() -> u32 {
    let start = unsafe { c7_drops() };
    match (KRef<Tracked>.create("nova.c7.tracked\0".ptr as *CChar, Tracked { tag: 7 })) {
        Err(e) => { return 0; }
        Ok(first) => {
            var four: u32 = 0;
            {
                let a = first.clone();
                let b = a.clone();
                let c = first.clone();
                four = c.count();
            }
            var early: u32 = 0;
            if (unsafe { c7_drops() } != start) { early = 1000; }
            return first.get().tag * 100 + four * 10 + first.count() + early;
        }
    }
}

/// A value freed after a grace period: still there after deferDrop returns, gone after Quiesce.synchronize.
/// Returns the tag * 100 + drops right after deferDrop * 10 + drops after the grace period: 901, or 0.
/// Safety: the module stays loaded until the callback has run (the grace period ends inside this function).
@export("c7_defer")
fn deferred() -> u32 {
    let start = unsafe { c7_drops() };
    match (Deferred<Tracked>.create(Tracked { tag: 9 })) {
        Err(e) => { return 0; }
        Ok(value) => {
            let tag = value.get().tag;
            unsafe { deferDrop(value); }
            let before = unsafe { c7_drops() } - start;
            Quiesce.synchronize();
            return tag * 100 + before * 10 + (unsafe { c7_drops() } - start);
        }
    }
}
