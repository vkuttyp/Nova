// lib/core: user-defined allocators (type-system.md §30, memory-model.md §3.2). Bundled with novac.

/// The size in bytes and the alignment (a power of two) of a block of memory.
public struct Layout {
    size: usize;
    align: usize;
}

/// An allocator a `Box<T, A>` can use: a struct without fields that implements this (type-system.md §30.2).
public interface Allocator {
    /// A block of at least `layout.size` bytes aligned to `layout.align`, or Err; never a null Ok.
    fn allocate(borrow this, layout: Layout) -> Result<*mut u8, AllocError>;

    /// Returns a block. Safety: `p` came from `allocate` of this allocator type with the same layout,
    /// and is returned once.
    unsafe fn deallocate(borrow this, p: *mut u8, layout: Layout);
}
