// Calling the C library through safe wrappers (type-system.md §28, language-spec Ex17). The interpreter
// models these functions (intermediate-representation.md §5.4); natively they are the C library's.

extern "C" {
    fn strlen(s: *CChar) -> usize;
    fn puts(s: *CChar) -> i32;
    fn abs(v: i32) -> i32;
    fn memcmp(a: *void, b: *void, n: usize) -> i32;
    fn memcpy(to: *mut void, from: *void, n: usize) -> *mut void;
    fn memset(to: *mut void, value: i32, n: usize) -> *mut void;
}

/// Safety: `text` must end in a zero byte, so `puts` stays inside it.
unsafe fn putLine(text: StringView) {
    puts(text.ptr as *CChar);
}

/// The length of the text before its first zero byte.
/// Safety: checks that the view contains a zero byte before handing it to `strlen`.
fn cLength(text: StringView) -> usize? {
    for (i in 0..text.length) {
        if (text.bytes()[i] == 0) { return unsafe { strlen(text.ptr as *CChar) }; }
    }
    return null;
}

/// Safety: both slices have `a.length` readable bytes when the lengths are equal.
fn sameBytes(a: Slice<u8>, b: Slice<u8>) -> bool {
    if (a.length != b.length) { return false; }
    return unsafe { memcmp(a.ptr as *void, b.ptr as *void, a.length) } == 0;
}

/// Safety: the slices are distinct (one is shared, one exclusive) and the length is checked.
fn copyInto(to: SliceMut<u8>, from: Slice<u8>) -> bool {
    if (to.length < from.length) { return false; }
    unsafe { memcpy(to.ptr as *mut void, from.ptr as *void, from.length); }
    return true;
}

/// Safety: `memset` writes exactly `to.length` bytes of the slice.
fn fill(to: SliceMut<u8>, value: u8) {
    unsafe { memset(to.ptr as *mut void, value as i32, to.length); }
}

/// Safety: the literal passed to putLine ends in a zero byte.
fn main() -> i32 {
    unsafe { putLine("hello from puts\0"); }
    Console.writeLine(cLength("four\0and more")!);
    Console.writeLine(cLength("none") == null);
    Console.writeLine(unsafe { abs(-42) });
    var a = [1u8, 2, 3, 4];
    var b = [1u8, 2, 3, 4];
    Console.writeLine(sameBytes(a[..], b[..]));
    b[3] = 9;
    Console.writeLine(sameBytes(a[..], b[..]));
    Console.writeLine(copyInto(mut b[..], a[1..]));
    Console.writeLine(b[0] as u32 + b[1] as u32 + b[2] as u32 + b[3] as u32);
    fill(mut a[1..3], 7);
    Console.writeLine(a[0] as u32 * 1000 + a[1] as u32 * 100 + a[2] as u32 * 10 + a[3] as u32);
    return 0;
}
// expect-stdout: hello from puts
// expect-stdout: 4
// expect-stdout: true
// expect-stdout: 42
// expect-stdout: true
// expect-stdout: false
// expect-stdout: true
// expect-stdout: 18
// expect-stdout: 1774
