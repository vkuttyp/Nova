fn yes(label: i32) -> bool {
    Console.write(label);
    Console.write(" ");
    return true;
}

fn no(label: i32) -> bool {
    Console.write(label);
    Console.write(" ");
    return false;
}

fn main() {
    Console.writeLine(no(1) && yes(2));
    Console.writeLine(yes(3) || no(4));
    Console.writeLine(yes(5) && no(6));
    Console.writeLine(no(7) || yes(8));
    Console.writeLine(no(9) || no(10) || yes(11) || yes(12));
}
// expect-stdout: 1 false
// expect-stdout: 3 true
// expect-stdout: 5 6 false
// expect-stdout: 7 8 true
// expect-stdout: 9 10 11 true
