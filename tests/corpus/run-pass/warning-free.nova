// Valid Nova that C compilers warn about; the generated C must still be warning-free (c-backend.md §5).
// Found by the M7d random program generator.
fn main() -> i32 {
    var x = 5i32;
    x = x;                        // -Wself-assign: emits nothing
    let y = 7u8;
    Console.writeLine(y == y);    // -Wtautological-compare: constant true
    Console.writeLine(x != x);
    Console.writeLine(x < x);
    Console.writeLine(y >= y);
    Console.writeLine(x);
    // GCC -Wtype-limits: comparisons a type's own limit decides.
    let u = 3u8;
    Console.writeLine(u < 0u8);
    Console.writeLine(u >= 0u8);
    Console.writeLine(u > 255u8);
    Console.writeLine(255u8 >= u);
    Console.writeLine(x <= 2147483647);
    Console.writeLine((-2147483648) > x);
    Console.writeLine(0u64 <= 18446744073709551615u64);
    return 0;
}
