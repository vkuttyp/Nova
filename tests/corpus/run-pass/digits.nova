fn digitSum(n: u64) -> u64 {
    var sum: u64 = 0;
    var rest = n;
    while (rest > 0) {
        sum += rest % 10;
        rest /= 10;
    }
    return sum;
}

fn reverse(n: u64) -> u64 {
    var result: u64 = 0;
    var rest = n;
    while (rest > 0) {
        result = result * 10 + rest % 10;
        rest /= 10;
    }
    return result;
}

fn main() {
    Console.writeLine(digitSum(987654321));
    Console.writeLine(reverse(12321) == 12321);
    Console.writeLine(reverse(1230));
}
// expect-stdout: 45
// expect-stdout: true
// expect-stdout: 321
