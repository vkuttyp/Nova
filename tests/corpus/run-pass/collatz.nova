fn steps(start: u64) -> u32 {
    var n = start;
    var count: u32 = 0;
    while (n != 1) {
        if (n % 2 == 0) { n = n / 2; } else { n = 3 * n + 1; }
        count += 1;
    }
    return count;
}

fn main() {
    Console.writeLine(steps(1));
    Console.writeLine(steps(27));
}
// expect-stdout: 0
// expect-stdout: 111
