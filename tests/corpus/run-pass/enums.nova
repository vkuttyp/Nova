enum Shape { Empty, Circle(i64), Rect(i64, i64) }
struct Wrapped { label: i32; shape: Shape; }

fn area(s: Shape) -> i64 {
    match (s) {
        Shape.Empty => { return 0; }
        Shape.Circle(r) => { return 3 * r * r; }
        Shape.Rect(w, h) => { return w * h; }
    }
}

fn grow(s: borrow mut Shape) {
    match (s) {
        Shape.Circle(r) => { r += 1; }
        Shape.Rect(w, _) => { w *= 2; }
        _ => { }
    }
}

fn describe(n: i32) {
    match (n) {
        0 => { Console.writeLine("zero"); }
        -1 => { Console.writeLine("minus one"); }
        _ => { Console.writeLine("other"); }
    }
}

fn main() {
    Console.writeLine(area(Shape.Empty));
    Console.writeLine(area(Shape.Circle(2)));
    var s = Shape.Rect(3, 4);
    Console.writeLine(area(s));
    grow(mut s);
    Console.writeLine(area(s));
    var c = Shape.Circle(1);
    grow(mut c);
    Console.writeLine(area(c));
    describe(0);
    describe(-1);
    describe(7);
    let flag = 3 > 2;
    match (flag) {
        true => { Console.writeLine("yes"); }
        false => { Console.writeLine("no"); }
    }
    let w = Wrapped { label: 1, shape: Shape.Rect(5, 6) };
    Console.writeLine(area(w.shape));
}
// expect-stdout: 0
// expect-stdout: 12
// expect-stdout: 12
// expect-stdout: 24
// expect-stdout: 12
// expect-stdout: zero
// expect-stdout: minus one
// expect-stdout: other
// expect-stdout: yes
// expect-stdout: 30
