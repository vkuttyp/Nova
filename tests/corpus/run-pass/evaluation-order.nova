fn trace(value: i32) -> i32 {
    Console.write(value);
    Console.write(" ");
    return value;
}

fn three(a: i32, b: i32, c: i32) -> i32 => a * 100 + b * 10 + c;

fn main() {
    Console.writeLine(trace(1) + trace(2) * trace(3));
    Console.writeLine(three(trace(4), trace(5), trace(6)));
    var x = 10;
    Console.writeLine(x - trace(x));
}
// expect-stdout: 1 2 3 7
// expect-stdout: 4 5 6 456
// expect-stdout: 10 0
