// A constant index past a fixed array's end: the check panics, and the C access after it must not trip
// -Warray-bounds (c-backend.md §5; found by the M7d random program generator). The same for a slice
// index too large for any object (found by the M7e campaign).
fn huge(xs: Slice<u64>) -> u64 {
    if (xs.length > 5) { return xs[18446744073709551614usize]; }
    return xs[0];
}

fn main() -> i32 {
    let s = [7u64, 8u64];
    Console.writeLine(huge(s[..]));
    var a: [i32; 3] = [1, 2, 3];
    Console.writeLine(a[1]);
    a[18446744073709551614usize] = 4; // expect-panic: index out of bounds
    return a[0];
}
// expect-stdout: 7
// expect-stdout: 2
