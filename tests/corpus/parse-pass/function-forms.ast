(unit
  (fn default noParams (params)
    (block)
  )
  (fn default noReturn (params (a i32))
    (block)
  )
  (fn default withReturn (params (a i32) (b i32)) (returns i32)
    (block
      (return (+ a b))
    )
  )
  (fn default trailingComma (params (a i32) (b i32)) (returns i32)
    (=> a)
  )
  (fn default expressionBody (params (x i64)) (returns i64)
    (=> (* x x))
  )
  (fn default qualifiedType (params (x Std.Num.Int)) (returns Std.Num.Int)
    (=> x)
  )
)
