struct Buffer {
    bytes: [u8; 16];
    used: usize;
}

fn total(xs: Slice<i32>, out: SliceMut<i64>) -> i32 {
    var sum = 0;
    for (x in xs) {
        sum += x;
    }
    for (i in 0..xs.length) {
        out[i] = xs[i] as i64;
    }
    return sum;
}

