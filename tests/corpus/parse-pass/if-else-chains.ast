(unit
  (fn default classify (params (n i32)) (returns i32)
    (block
      (if (< n 0)
        (block
          (return (neg 1))
        )
        (else
          (if (== n 0)
            (block
              (return 0)
            )
            (else
              (if (< n 10)
                (block
                  (return 1)
                )
                (else
                  (block
                    (return 2)
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  (fn default nested (params (a bool) (b bool))
    (block
      (if a
        (block
          (if b
            (block)
            (else
              (block)
            )
          )
        )
      )
    )
  )
)
