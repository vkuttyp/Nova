interface Shape { fn area(borrow this) -> i64; fn scale(borrow mut this, by: i64); }
interface Comparable<T> { fn compare(borrow this, other: borrow T) -> i32; }
impl Shape for Square {
    fn area(borrow this) -> i64 => this.side * this.side;
    fn scale(borrow mut this, by: i64) { this.side *= by; }
}
impl Comparable<i32> for i32 { fn compare(borrow this, other: borrow i32) -> i32 => 0; }
fn total<S: Shape + Copy, T: Comparable<T>>(s: S, t: T) { }
