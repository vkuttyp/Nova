(unit
  (struct default Counter
    (field default count u32)
    (fn default get (params (borrow this)) (returns u32)
      (=> (. this count))
    )
    (fn default bump (params (borrow mut this) (by u32))
      (block
        (+= (. this count) by)
      )
    )
    (fn default slot (params (borrow mut this)) (returns (borrow-mut u32))
      (=> (borrow-mut (. this count)))
    )
  )
  (fn default pick (params (a (borrow i64)) (b (borrow-mut i64))) (returns (borrow(a b) i64))
    (=> a)
  )
  (fn default same (params (v (borrow(this) i64)))
    (block)
  )
  (fn default use (params (c (borrow-mut Counter)))
    (block
      (var x : i64 = 1)
      (let r = (borrow x))
      (let m = (borrow-mut x))
      (expr (call reset (mut-arg x) (mut-arg (. c count)) (borrow (neg x))))
      (expr (call (. c bump) (+ r 1)))
    )
  )
)
