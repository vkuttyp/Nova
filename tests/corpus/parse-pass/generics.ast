(unit
  (struct default Pair (type-params T)
    (field default first T)
    (field default second T)
  )
  (enum default Either (type-params L R)
    (variant Left L)
    (variant Right R)
  )
  (fn default id (type-params T) (params (x T)) (returns T)
    (=> x)
  )
  (fn default bounded (type-params (T Show Eq) U) (params (x T) (y U))
    (block)
  )
  (fn default uses (params)
    (block
      (let a = (call (generic id i32) 1))
      (let b = (new Pair<u8> (first 1u8) (second 2u8)))
      (let c = (new Pair (first 1) (second 2)))
      (let d = (call (. (generic Either i32 bool) Left) 1))
      (let e : (Pair (Pair i32)) = (call (generic make (Pair i32))))
      (let f = (call (. (generic Pair i32) zero)))
      (if (< a b)
        (block)
      )
    )
  )
)
