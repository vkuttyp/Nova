(unit
  (interface default Shape
    (fn default area (params (borrow this)) (returns i64)
    )
    (fn default scale (params (borrow mut this) (by i64))
    )
  )
  (interface default Comparable (type-params T)
    (fn default compare (params (borrow this) (other (borrow T))) (returns i32)
    )
  )
  (impl Shape for Square
    (fn default area (params (borrow this)) (returns i64)
      (=> (* (. this side) (. this side)))
    )
    (fn default scale (params (borrow mut this) (by i64))
      (block
        (*= (. this side) by)
      )
    )
  )
  (impl (Comparable i32) for i32
    (fn default compare (params (borrow this) (other (borrow i32))) (returns i32)
      (=> 0)
    )
  )
  (fn default total (type-params (S Shape Copy) (T (Comparable T))) (params (s S) (t T))
    (block)
  )
)
