fn f(a: u8, b: i32, s: i32, p: bool, w: u64) {
    let x1 = a + b; // error[N0207]
    let x2 = s & s; // error[N0207]
    let x3 = s << 1; // error[N0207]
    let x4 = p + p; // error[N0207]
    let x5 = p < p; // error[N0207]
    let x6 = -a; // error[N0207]
    let x7 = -1u32; // error[N0207]
    let x8 = !b; // error[N0205]
    let x9 = w << p; // error[N0207]
    let x10 = b && p; // error[N0205]
    let ok = a == 1 && p == !p && w >> 3 == 0;
}
