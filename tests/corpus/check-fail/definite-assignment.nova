fn ifWithoutElse(flag: bool) -> i32 {
    var x: i32;
    if (flag) { x = 1; }
    return x; // error[N0212]
}
fn onlyInLoopBody(n: u32) -> u32 {
    var last: u32;
    var i: u32 = 0;
    while (i < n) { last = i; i += 1; }
    return last; // error[N0212]
}
fn compoundBeforeAssign() -> u32 {
    var total: u32;
    total += 1; // error[N0212]
    return total;
}
fn breakBeforeAssign(flag: bool) -> u32 {
    var v: u32;
    loop {
        if (flag) { break; }
        v = 1;
        break;
    }
    return v; // error[N0212]
}
fn reportedOncePerVariable() -> u32 {
    var y: u32;
    let a = y; // error[N0212]
    let b = y;
    return a + b;
}
