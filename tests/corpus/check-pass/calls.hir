(program
  (fn fib ((n#0: u32)) -> u64
    (block
      (if (< n#0 2:u32):bool
        (block
          (return (as n#0 u64))
        )
      )
      (return (+ (call fib (- n#0 1:u32):u32):u64 (call fib (- n#0 2:u32):u32):u64):u64)
    )
  )
  (fn isEven ((n#0: u32)) -> bool
    (block
      (if (== n#0 0:u32):bool
        (block
          (return true)
        )
      )
      (return (call isOdd (- n#0 1:u32):u32):bool)
    )
  )
  (fn isOdd ((n#0: u32)) -> bool
    (block
      (if (== n#0 0:u32):bool
        (block
          (return false)
        )
      )
      (return (call isEven (- n#0 1:u32):u32):bool)
    )
  )
  (fn log ((value#0: u64)) -> void
    (block
      (expr (Console.writeLine value#0))
    )
  )
  (fn logTwice ((value#0: u64)) -> void
    (block
      (expr (call log value#0):void)
    )
  )
  (fn run () -> void
    (block
      (expr (call logTwice (call fib 10:u32):u64):void)
      (expr (call log (call later 1:u64 2:u64):u64):void)
    )
  )
  (fn later ((a#0: u64) (b#1: u64)) -> u64
    (block
      (return (+ a#0 b#1):u64)
    )
  )
)
