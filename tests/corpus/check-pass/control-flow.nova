fn classify(n: i32) -> i32 {
    if (n < 0) {
        return -1;
    } else if (n == 0) {
        return 0;
    } else {
        return 1;
    }
}

fn firstMultiple(step: u32, limit: u32) -> u32 {
    var i: u32 = 1;
    while (i < limit) {
        if (i % step == 0) {
            break;
        }
        i += 1;
    }
    return i;
}

fn sumOdd(n: u32) -> u32 {
    var total: u32 = 0;
    var i: u32 = 0;
    loop {
        i += 1;
        if (i > n) { break; }
        if (i % 2 == 0) { continue; }
        total += i;
    }
    return total;
}

// A `loop` without `break` never completes, so no return is needed after it.
fn spin() -> i32 {
    loop { }
}

// Process.exit never returns, so it also ends a path.
fn fail(code: i32) -> u64 {
    Process.exit(code);
}

fn nested(n: u32) -> u32 {
    var count: u32 = 0;
    var i: u32 = 0;
    while (i < n) {
        var j: u32 = 0;
        while (j < i) {
            count += 1;
            j += 1;
        }
        i += 1;
    }
    return count;
}
