(program
  (fn classify ((n#0: i32)) -> i32
    (block
      (if (< n#0 0:i32):bool
        (block
          (return -1:i32)
        )
        (else
          (if (== n#0 0:i32):bool
            (block
              (return 0:i32)
            )
            (else
              (block
                (return 1:i32)
              )
            )
          )
        )
      )
    )
  )
  (fn firstMultiple ((step#0: u32) (limit#1: u32)) -> u32
    (block
      (var i#2: u32 = 1:u32)
      (while (< i#2 limit#1):bool
        (block
          (if (== (% i#2 step#0):u32 0:u32):bool
            (block
              (break)
            )
          )
          (+= i#2 1:u32)
        )
      )
      (return i#2)
    )
  )
  (fn sumOdd ((n#0: u32)) -> u32
    (block
      (var total#1: u32 = 0:u32)
      (var i#2: u32 = 0:u32)
      (loop
        (block
          (+= i#2 1:u32)
          (if (> i#2 n#0):bool
            (block
              (break)
            )
          )
          (if (== (% i#2 2:u32):u32 0:u32):bool
            (block
              (continue)
            )
          )
          (+= total#1 i#2)
        )
      )
      (return total#1)
    )
  )
  (fn spin () -> i32
    (block
      (loop
        (block)
      )
    )
  )
  (fn fail ((code#0: i32)) -> u64
    (block
      (expr (Process.exit code#0))
    )
  )
  (fn nested ((n#0: u32)) -> u32
    (block
      (var count#1: u32 = 0:u32)
      (var i#2: u32 = 0:u32)
      (while (< i#2 n#0):bool
        (block
          (var j#3: u32 = 0:u32)
          (while (< j#3 i#2):bool
            (block
              (+= count#1 1:u32)
              (+= j#3 1:u32)
            )
          )
          (+= i#2 1:u32)
        )
      )
      (return count#1)
    )
  )
)
