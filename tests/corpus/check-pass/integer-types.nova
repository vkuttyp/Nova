// Every integer type, and every lossless 'as' conversion direction (type-system.md §7).
fn widen(a: i8, b: i16, c: i32, d: u8, e: u16, f: u32, g: bool) -> i64 {
    let a2 = a as i16;
    let b2 = b as i32;
    let c2 = c as i64;
    let d2 = d as u16;
    let e2 = e as u32;
    let f2 = f as u64;
    let d3 = d as i16;          // unsigned to a wider signed type
    let f3 = f as i64;
    let g2 = g as u8;           // bool to integer
    let s1: isize = c as isize;
    let s2: usize = f as usize;
    let s3 = s2 as u64;         // same width on LP64 targets
    let same = c as i32;        // identity
    return c2 + f3 + a2 as i64;
}
