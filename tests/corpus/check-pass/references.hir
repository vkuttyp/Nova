    (block
      (if (> (deref a#0):i64 (deref b#1):i64):bool
        (block
          (return a#0)
        )
      )
      (return b#1)
    )
  )
  (fn make () -> Counter
    (block
      (return (new Counter (count 7:u32)))
    )
  )
  (fn demo () -> u32
    (block
      (var x#0: i64 = 21:i64)
      (let doubled#1: i64 = (+ (call twice (borrow x#0)):i64 (call twice (borrow-temp 5:i64)):i64):i64)
      (let r#2: borrow i64 = (borrow x#0))
      (let sum#3: i64 = (+ (deref r#2):i64 doubled#1):i64)
      (expr (call reset (borrow-mut x#0)):void)
