fn bothBranches(flag: bool) -> i32 {
    var x: i32;
    if (flag) { x = 1; } else { x = 2; }
    return x;
}

fn assignedBeforeBreak() -> u32 {
    var found: u32;
    loop {
        found = 42;
        break;
    }
    return found;
}

fn elseIfChain(n: i32) -> i32 {
    var r: i32;
    if (n < 0) { r = -1; } else if (n == 0) { r = 0; } else { r = 1; }
    return r;
}

fn earlyReturn(flag: bool) -> i32 {
    var x: i32;
    if (flag) { return 0; } else { x = 5; }
    return x;
}

fn exitBranch(flag: bool) -> i32 {
    var x: i32;
    if (flag) { x = 1; } else { Process.exit(3); }
    return x;
}
