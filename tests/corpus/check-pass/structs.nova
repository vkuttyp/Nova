struct Point {
    x: i64;
    y: i64;

    fn sum(this) -> i64 => this.x + this.y;
    fn scaled(this, k: i64) -> Point => Point { y: this.y * k, x: this.x * k };
    fn origin() -> Point => Point { x: 0, y: 0 };
}

struct Rect { min: Point; max: Point; }

fn area(r: Rect) -> i64 => (r.max.x - r.min.x) * (r.max.y - r.min.y);

fn update(start: Rect) -> i64 {
    var r = start;
    r.max.x = 10;
    r.max.y += 1;
    let corner = r.max.scaled(2);
    return area(r) + corner.sum() + Point.origin().sum();
}
