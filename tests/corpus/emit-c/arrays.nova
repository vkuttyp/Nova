struct Pair { v: [i16; 2]; }

fn total(xs: Slice<i32>) -> i32 {
    var t = 0;
    for (x in xs) { t += x; }
    return t;
}

fn zero(xs: SliceMut<i32>) {
    xs[0] = 0;
}

fn main() -> i32 {
    var a = [1, 2, 3];
    let p = Pair { v: [4i16; 2] };
    zero(mut a[1..]);
    let i = 2usize;
    a[i] = p.v[1] as i32;
    return total(a[..]) + a[0];
}
